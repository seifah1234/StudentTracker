<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - نظام متابعة الطلاب</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.rtl.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary mb-4">
            <div class="container-fluid">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">نظام متابعة الطلاب</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNav">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item"><a class="nav-link" asp-controller="Teachers" asp-action="Index">المدرّسون</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="ClassRooms" asp-action="Index">الفصول</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Students" asp-action="Index">الطلاب</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Subjects" asp-action="Index">المواد</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Assessments" asp-action="Index">التقييمات</a></li>
                            <li class="nav-item"><a class="nav-link" asp-controller="Attendance" asp-action="Index">الحضور والغياب</a></li>
                        </ul>
                        <form asp-controller="Auth" asp-action="Logout" method="post" class="d-flex">
                            <span class="navbar-text text-white-50 me-3">مرحباً، @User.Identity!.Name</span>
                            <button type="submit" class="btn btn-outline-light btn-sm">تسجيل الخروج</button>
                        </form>
                    }
                    else
                    {
                        <ul class="navbar-nav ms-auto">
                            <li class="nav-item"><a class="nav-link" asp-controller="Auth" asp-action="Login">تسجيل الدخول</a></li>
                        </ul>
                    }
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        @if (TempData["Success"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                @TempData["Success"]
                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
            </div>
        }
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted text-center py-3 mt-4">
        <div class="container">
            &copy; @DateTime.Now.Year - نظام متابعة الطلاب (StudentTracker)
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
