@model List<StudentViewModel>
@{
    ViewData["Title"] = "طلاب الفصل";
}

<h1 class="h3 mb-4">طلاب الفصل: @ViewBag.ClassRoomName</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">لا يوجد طلاب في هذا الفصل بعد.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>الاسم</th>
                    <th>الرقم القومي</th>
                    <th>هاتف ولي الأمر</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>@s.NationalId</td>
                        <td>@(s.ParentPhoneNumber ?? "-")</td>
                        <td class="text-end">
                            <a asp-controller="Students" asp-action="Details" asp-route-id="@s.Id" class="btn btn-sm btn-outline-info">عرض</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary">العودة لقائمة الفصول</a>
