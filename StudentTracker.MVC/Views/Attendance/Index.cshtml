@model List<AttendanceViewModel>
@{
    ViewData["Title"] = "الحضور والغياب";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">سجلات الحضور والغياب</h1>
    <a asp-action="Create" class="btn btn-primary">+ تسجيل حضور</a>
</div>


<form method="get" class="row row-cols-lg-auto g-2 align-items-center mb-3">
    <div class="col-12">
        <input type="number" name="studentId" value="@ViewBag.StudentId" class="form-control" placeholder="رقم الطالب" />
    </div>
    <div class="col-12">
        <input type="date" name="date" value="@(ViewBag.Date != null ? ((DateTime)ViewBag.Date).ToString("yyyy-MM-dd") : "")" class="form-control" />
    </div>
    <div class="col-12">
        <button type="submit" class="btn btn-outline-primary">فلترة</button>
        <a asp-action="Index" class="btn btn-outline-secondary">إعادة تعيين</a>
    </div>
</form>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد سجلات مطابقة.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>الطالب</th>
                    <th>التاريخ</th>
                    <th>الحالة</th>
                    <th>ملاحظات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td>@(a.StudentName ?? $"#{a.StudentId}")</td>
                        <td>@(a.Date.ToString("yyyy-MM-dd"))</td>
                        <td>
                            @{
                                var statusText = a.Status ?? a.AttendanceStatus.ToString();
                                var badgeClass = statusText switch
                                {
                                    "Present" => "badge-present",
                                    "Absent" => "badge-absent",
                                    "Late" => "badge-late",
                                    _ => "bg-secondary"
                                };
                            }
                            <span class="badge @badgeClass">@statusText</span>
                        </td>
                        <td>@(a.Notes ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
