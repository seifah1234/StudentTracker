@model List<SubjectViewModel>
@{
    ViewData["Title"] = "المواد";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">المواد الدراسية</h1>
    <a asp-action="Create" class="btn btn-primary">+ إضافة مادة</a>
</div>


@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد مواد بعد.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>الكود</th>
                    <th>اسم المادة</th>
                    <th>الفصل</th>
                    <th>الدرجة النهائية</th>
                    <th>الوصف</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    <tr>
                        <td>@s.Code</td>
                        <td>@s.Name</td>
                        <td>
                            <a asp-controller="ClassRooms" asp-action="Details" asp-route-id="@s.ClassRoomId">#@s.ClassRoomId</a>
                        </td>
                        <td>@s.MaximumMarks</td>
                        <td>@(s.Description ?? "-")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
