@model SubjectViewModel

<div class="mb-3">
    <label asp-for="Code" class="form-label"></label>
    <input asp-for="Code" class="form-control" />
    <span asp-validation-for="Code" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Name" class="form-label"></label>
    <input asp-for="Name" class="form-control" />
    <span asp-validation-for="Name" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="ClassRoomId" class="form-label"></label>
    <input asp-for="ClassRoomId" class="form-control" type="number" />
    <span asp-validation-for="ClassRoomId" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="MaximumMarks" class="form-label"></label>
    <input asp-for="MaximumMarks" class="form-control" type="number" step="0.5" />
    <span asp-validation-for="MaximumMarks" class="text-danger"></span>
</div>
<div class="mb-3">
    <label asp-for="Description" class="form-label"></label>
    <textarea asp-for="Description" class="form-control" rows="3"></textarea>
    <span asp-validation-for="Description" class="text-danger"></span>
</div>
