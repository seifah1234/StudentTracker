@model List<ClassRoomViewModel>
@{
    ViewData["Title"] = "فصول المدرّس";
}

<h1 class="h3 mb-4">فصول المدرّس: @ViewBag.TeacherName</h1>

@if (!Model.Any())
{
    <div class="alert alert-info">لا توجد فصول لهذا المدرّس.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>اسم الفصل</th>
                    <th>العام الدراسي</th>
                    <th>الفصل الدراسي</th>
                    <th>عدد الطلاب المتوقع</th>
                    <th class="text-end">الإجراءات</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var c in Model)
                {
                    <tr>
                        <td>@c.Name</td>
                        <td>@c.AcademicYear</td>
                        <td>@c.Semester</td>
                        <td>@c.ExpectedStudentCount</td>
                        <td class="text-end">
                            <a asp-controller="ClassRooms" asp-action="Details" asp-route-id="@c.Id" class="btn btn-sm btn-outline-info">عرض</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<a asp-action="Index" class="btn btn-outline-secondary">العودة لقائمة المدرّسين</a>
