@model StudentViewModel
@{
    ViewData["Title"] = "عرض طالب";
    var subjectsLevels = ViewBag.SubjectsLevels as List<string> ?? new List<string>();
}

<h1 class="h3 mb-4">بيانات الطالب</h1>

<dl class="row">
    <dt class="col-sm-3">الاسم</dt>
    <dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">الرقم القومي</dt>
    <dd class="col-sm-9">@Model.NationalId</dd>
    <dt class="col-sm-3">تاريخ الميلاد</dt>
    <dd class="col-sm-9">@Model.BirthDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">تاريخ الالتحاق</dt>
    <dd class="col-sm-9">@Model.EnrollementDate.ToString("yyyy-MM-dd")</dd>
    <dt class="col-sm-3">هاتف ولي الأمر</dt>
    <dd class="col-sm-9">@(Model.ParentPhoneNumber ?? "-")</dd>
    <dt class="col-sm-3">الفصل</dt>
    <dd class="col-sm-9">
        <a asp-controller="ClassRooms" asp-action="Details" asp-route-id="@Model.ClassRoomId">#@Model.ClassRoomId</a>
    </dd>
    @if (ViewBag.TotalLevel != null)
    {
        <dt class="col-sm-3">المستوى العام</dt>
        <dd class="col-sm-9"><span class="badge bg-primary">@ViewBag.TotalLevel</span></dd>
    }
    @if (subjectsLevels.Any())
    {
        <dt class="col-sm-3">مستوى المواد</dt>
        <dd class="col-sm-9">
            @foreach (var lvl in subjectsLevels)
            {
                <span class="badge bg-secondary me-1">@lvl</span>
            }
        </dd>
    }
</dl>

<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">تعديل</a>
<a asp-action="Index" class="btn btn-outline-secondary">العودة للقائمة</a>
